{
  "id": "pwd-professional",
  "name": "PWD Professional",
  "tagline": "Formal departmental sheet with a title band, structured legend and a signed-off footer.",
  "recommended": true,
  "pageSize": "A4",
  "orientation": "landscape",
  "margin": 9,
  "basemap": "none",
  "theme": {
    "paper": "#ffffff",
    "ink": "#10233d",
    "muted": "#5b6e8a",
    "accent": "#0d5c9e",
    "band": "#0d3b66",
    "bandTo": "#12609f",
    "bandInk": "#ffffff",
    "rule": "#c7d4e4",
    "frame": "#10233d",
    "panel": "#f5f8fc",
    "font": "\"Segoe UI\", Inter, system-ui, sans-serif",
    "titleWeight": "700",
    "titleTracking": 0.4,
    "titleCase": "upper"
  },
  "header": { "show": true, "style": "band", "height": 19, "align": "left" },
  "logo": { "show": true, "position": "header-left", "size": 13 },
  "legend": { "show": true, "position": "right", "width": 54, "style": "card", "title": "Legend" },
  "northArrow": { "show": true, "position": "map-top-right", "style": "classic", "size": 15 },
  "scaleBar": { "show": true, "position": "map-bottom-left", "style": "checker", "width": 46 },
  "metadata": { "show": true, "position": "bottom", "height": 15, "style": "strip", "columns": 4 },
  "grid": { "show": false, "style": "ticks" },
  "neatline": { "show": true, "width": 0.8, "double": true, "gap": 1.1 },
  "mapEmphasis": { "road": 1.35, "asset": 1.2, "boundary": 1, "opacity": 1 },
  "labels": { "show": true }
}
