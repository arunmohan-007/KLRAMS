{
  "id": "road-asset-inspection",
  "name": "Road & Asset Inspection",
  "tagline": "Assets read first: larger symbols, a wide symbol legend and an inspection footer.",
  "pageSize": "A4",
  "orientation": "landscape",
  "margin": 9,
  "basemap": "osm",
  "theme": {
    "paper": "#ffffff",
    "ink": "#1b1206",
    "muted": "#6d5f4c",
    "accent": "#b86a1c",
    "band": "#2b2419",
    "bandTo": "#3d3324",
    "bandInk": "#ffe9c9",
    "rule": "#dccdb6",
    "frame": "#2b2419",
    "panel": "#fdf8f0",
    "font": "\"Segoe UI\", Inter, system-ui, sans-serif",
    "titleWeight": "700",
    "titleTracking": 0.6,
    "titleCase": "upper"
  },
  "header": { "show": true, "style": "band", "height": 18, "align": "left" },
  "logo": { "show": true, "position": "header-left", "size": 12 },
  "legend": { "show": true, "position": "right", "width": 58, "style": "symbols", "title": "Assets & layers" },
  "northArrow": { "show": true, "position": "map-top-left", "style": "classic", "size": 14 },
  "scaleBar": { "show": true, "position": "map-bottom-left", "style": "checker", "width": 44 },
  "metadata": { "show": true, "position": "bottom", "height": 14, "style": "strip", "columns": 4 },
  "grid": { "show": false, "style": "ticks" },
  "neatline": { "show": true, "width": 0.7, "double": false },
  "mapEmphasis": { "road": 0.95, "asset": 1.75, "boundary": 0.9, "opacity": 1 },
  "labels": { "show": true }
}
