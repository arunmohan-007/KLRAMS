{
  "id": "bridge-culvert",
  "name": "Bridge & Culvert",
  "tagline": "Engineering drawing feel — hairline neatline, coordinate ticks, structures dominant, network subdued.",
  "pageSize": "A3",
  "orientation": "landscape",
  "margin": 11,
  "basemap": "none",
  "theme": {
    "paper": "#ffffff",
    "ink": "#0a0a0a",
    "muted": "#4a4a4a",
    "accent": "#7d1128",
    "band": "#ffffff",
    "bandInk": "#0a0a0a",
    "rule": "#9a9a9a",
    "frame": "#0a0a0a",
    "panel": "#ffffff",
    "font": "\"Segoe UI\", Inter, system-ui, sans-serif",
    "titleWeight": "600",
    "titleTracking": 1.6,
    "titleCase": "upper"
  },
  "header": { "show": true, "style": "rule", "height": 16, "align": "center" },
  "logo": { "show": true, "position": "header-left", "size": 11 },
  "legend": { "show": true, "position": "right", "width": 56, "style": "table", "title": "Structure key" },
  "northArrow": { "show": true, "position": "map-top-right", "style": "engineer", "size": 15 },
  "scaleBar": { "show": true, "position": "below-map", "style": "checker", "width": 60 },
  "metadata": { "show": true, "position": "bottom", "height": 17, "style": "titleblock", "columns": 4 },
  "grid": { "show": true, "style": "ticks", "labels": true },
  "neatline": { "show": true, "width": 0.45, "double": true, "gap": 1.6 },
  "mapEmphasis": { "road": 0.7, "asset": 1.9, "boundary": 0.7, "opacity": 1 },
  "labels": { "show": true }
}
