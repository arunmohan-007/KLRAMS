{
  "id": "road-network-overview",
  "name": "Road Network Overview",
  "tagline": "Maximum map for a district or a whole filtered network, with a floating legend that keeps out of the way.",
  "pageSize": "A4",
  "orientation": "landscape",
  "margin": 8,
  "basemap": "none",
  "theme": {
    "paper": "#ffffff",
    "ink": "#132033",
    "muted": "#61748e",
    "accent": "#17795e",
    "band": "#ffffff",
    "bandInk": "#132033",
    "rule": "#d8e1ec",
    "frame": "#8fa2b8",
    "panel": "rgba(255,255,255,.93)",
    "font": "\"Segoe UI\", Inter, system-ui, sans-serif",
    "titleWeight": "700",
    "titleTracking": 0.2,
    "titleCase": "none"
  },
  "header": { "show": true, "style": "plain", "height": 17, "align": "center" },
  "logo": { "show": true, "position": "header-right", "size": 11 },
  "legend": { "show": true, "position": "map-auto", "width": 46, "style": "floating", "title": "Legend" },
  "northArrow": { "show": true, "position": "map-top-right", "style": "needle", "size": 13 },
  "scaleBar": { "show": true, "position": "map-bottom-right", "style": "bar", "width": 42 },
  "metadata": { "show": true, "position": "bottom", "height": 9, "style": "line", "columns": 3 },
  "grid": { "show": false, "style": "ticks" },
  "neatline": { "show": true, "width": 0.5, "double": false },
  "mapEmphasis": { "road": 1.6, "asset": 1.1, "boundary": 1.2, "opacity": 1 },
  "labels": { "show": true }
}
