{
  "id": "minimal-modern",
  "name": "Minimal Modern",
  "tagline": "Edge-to-edge map, one hairline frame, title and legend as quiet floating cards.",
  "pageSize": "A4",
  "orientation": "landscape",
  "margin": 6,
  "basemap": "none",
  "theme": {
    "paper": "#ffffff",
    "ink": "#111820",
    "muted": "#7b8794",
    "accent": "#0f9d8f",
    "band": "#ffffff",
    "bandInk": "#111820",
    "rule": "#e6ebf0",
    "frame": "#dbe2e9",
    "panel": "rgba(255,255,255,.92)",
    "font": "\"Segoe UI\", Inter, system-ui, sans-serif",
    "titleWeight": "600",
    "titleTracking": -0.2,
    "titleCase": "none"
  },
  "header": { "show": true, "style": "overlay", "height": 0, "align": "left" },
  "logo": { "show": false, "position": "map-top-right", "size": 10 },
  "legend": { "show": true, "position": "map-auto", "width": 42, "style": "floating", "title": "" },
  "northArrow": { "show": true, "position": "map-top-right", "style": "minimal", "size": 11 },
  "scaleBar": { "show": true, "position": "map-bottom-right", "style": "line", "width": 38 },
  "metadata": { "show": true, "position": "overlay-bottom", "height": 0, "style": "line", "columns": 3 },
  "grid": { "show": false, "style": "ticks" },
  "neatline": { "show": true, "width": 0.35, "double": false },
  "mapEmphasis": { "road": 1.25, "asset": 1.15, "boundary": 0.85, "opacity": 1 },
  "labels": { "show": true }
}
