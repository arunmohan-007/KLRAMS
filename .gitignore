# =====================
# Videos
# =====================
video-store/
*.mp4
*.webm
*.mov
*.avi

# =====================
# Build files (Spring Boot / Maven)
# =====================
target/
*.log

# =====================
# Local secrets (never commit)
# =====================
application-local.properties
application-*.local.properties
.env
*.dump

# =====================
# GIS data
# =====================
*.tif
*.tiff
# ...except the Drone module's test fixtures. These are small, deliberately
# committed GeoTIFFs written by GDAL (LZW, tiled, one float32 DEM) that
# GeoTiffMetaTest reads; without them the build fails on a fresh clone.
!src/test/resources/drone/*.tif

# =====================
# Drone module raster store (local dev). Uploaded originals and the PNG tile
# pyramids built from them — the same reason video-store/ is ignored.
# =====================
drone-store/

# =====================
# Raster temporary-layer store (local dev) — same reason as drone-store/.
# =====================
raster-layer-store/

# =====================
# Node (if used later)
# =====================
node_modules/

